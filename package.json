{
  "name": "time-tracker",
  "private": true,
  "version": "0.2.3",
  "description": "Трекер рабочего времени для фрилансеров: проекты, задачи, таймер, ставки и отчёты",
  "author": "derab <derabonn@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "app": "electron .",
    "app:dev": "VITE_DEV_SERVER_URL=http://localhost:5173/ electron .",
    "icons": "node scripts/gen-tray-icons.mjs && node scripts/gen-app-icon.mjs build/icon_1024.png && rm -rf build/icon.iconset && mkdir -p build/icon.iconset && for s in 16 32 128 256 512; do sips -z $s $s build/icon_1024.png --out build/icon.iconset/icon_${s}x${s}.png >/dev/null; sips -z $((s*2)) $((s*2)) build/icon_1024.png --out build/icon.iconset/icon_${s}x${s}@2x.png >/dev/null; done && iconutil -c icns build/icon.iconset -o build/icon.icns && rm -rf build/icon.iconset",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "release:patch": "npm version patch -m \"Релиз v%s\"",
    "release:minor": "npm version minor -m \"Релиз v%s\""
  },
  "dependencies": {
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.derab.timetracker",
    "productName": "Time Tracker",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dr34mka",
        "repo": "time-tracker",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
}
